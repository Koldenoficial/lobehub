# =============================================================================
# Kolden VPS - configuration
# 1. Copy this file:            cp .env.example .env
# 2. Fill in the domains below
# 3. Generate the secrets:      ./gerar-segredos.sh
# =============================================================================

# --- Domains (each one needs a DNS "A" record pointing to the VPS IP) ---------
LOBE_DOMAIN=chat.suaempresa.com.br
S3_DOMAIN=arquivos.suaempresa.com.br
GATEWAY_DOMAIN=gateway.suaempresa.com.br
CRM_DOMAIN=crm.suaempresa.com.br

# E-mail used by Let's Encrypt for certificate expiry notices
ACME_EMAIL=ti@suaempresa.com.br

# --- Who may create a LobeHub account (comma-separated) ----------------------
# Leave empty to allow anyone with the link to register.
# Recommended: list only the team's e-mails.
AUTH_ALLOWED_EMAILS=

# --- Optional web search in LobeHub (uses ~200 MB of RAM) --------------------
# Uncomment below AND set SEARXNG_URL=http://searxng:8080 in lobehub.env
# COMPOSE_PROFILES=busca

# --- Image versions (pin them once everything works) -------------------------
LOBE_TAG=latest
LOBE_GATEWAY_TAG=0.5.0
TWENTY_TAG=latest
RUSTFS_TAG=latest

# =============================================================================
# Secrets - filled in by ./gerar-segredos.sh. Do not share or commit this file.
# =============================================================================
KEY_VAULTS_SECRET=
AUTH_SECRET=
GATEWAY_SERVICE_TOKEN=
JWKS_KEY=
JWKS_PUBLIC_KEY=
LOBE_POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=lobeadmin
RUSTFS_SECRET_KEY=
TWENTY_POSTGRES_PASSWORD=
TWENTY_ENCRYPTION_KEY=
