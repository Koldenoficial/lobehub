# Optional extra LobeHub settings, loaded only by the LobeHub container.
# Copy to lobehub.env and uncomment what you need:  cp lobehub.env.example lobehub.env
# Full list: https://lobehub.com/docs/self-hosting/environment-variables

# AI provider keys shared by the whole team (each user can also add their own in the app)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Only allow sign-in with SSO (disables e-mail/password registration)
# AUTH_DISABLE_EMAIL_PASSWORD=1

# Web search (only with COMPOSE_PROFILES=busca in .env)
# SEARXNG_URL=http://searxng:8080
